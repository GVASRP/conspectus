[Unit]
Description=Conspectus Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/conspectus
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/conspectus/.venv/bin/python run_bot.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target